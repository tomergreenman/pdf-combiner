# Copy to `.env` to configure the lightweight access gate.
#
# VITE_ACCESS_GATE: "on" to require a password before the app loads, "off" to disable.
# Default when unset is "off".
VITE_ACCESS_GATE=off
#
# VITE_ACCESS_HASH: SHA-256 hex digest of your password. Generate with:
#   npm run hash-password -- "your secret phrase"
# Only used when VITE_ACCESS_GATE=on.
VITE_ACCESS_HASH=
